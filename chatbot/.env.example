# Backend: "foundry_agent" uses the published Foundry Agent; "rag" uses RAG_BASE_URL.
CHAT_PROVIDER=foundry_agent

# Allowed endpoints, Agent names and versions are maintained in agents.json.
FOUNDRY_AGENTS_FILE=agents.json
FOUNDRY_DEFAULT_AGENT_ID=sharepoint

# Local account authentication. In production set COOKIE_SECURE=true behind HTTPS.
LOCAL_AUTH_ENABLED=true
ALLOW_SELF_REGISTRATION=true
AUTH_SESSION_DAYS=14
COOKIE_SECURE=false

# Optional but recommended: creates the first admin only when no admin exists.
# Set these only in chatbot/.env or the host's secret store; never commit a real password.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional: select a tenant when your account belongs to multiple Entra tenants.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_CERTIFICATE_PATH=/secure/path/abs-agent.pfx
# AZURE_CLIENT_CERTIFICATE_PASSWORD=certificate-password

# Used only when CHAT_PROVIDER=rag.
RAG_BASE_URL=http://localhost:8000
RAG_API_KEY=

# Optional protection for this chatbot API.
CHATBOT_API_KEY=