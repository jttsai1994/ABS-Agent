# Backend: "foundry_agent" uses the published Foundry Agent; "rag" uses RAG_BASE_URL.
CHAT_PROVIDER=foundry_agent

# Copy these values from Foundry portal > Agent > Call agent.
FOUNDRY_PROJECT_ENDPOINT=https://poc-test-foundryiq.services.ai.azure.com/api/projects/poc-test-foundryiq
FOUNDRY_AGENT_NAME=abs-sharepoint
FOUNDRY_AGENT_VERSION=9

# Optional: select a tenant when your account belongs to multiple Entra tenants.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Used only when CHAT_PROVIDER=rag.
RAG_BASE_URL=http://localhost:8000
RAG_API_KEY=

# Optional protection for this chatbot API.
CHATBOT_API_KEY=